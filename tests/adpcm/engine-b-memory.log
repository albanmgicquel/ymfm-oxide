engine b
shift 0
rshift 2
samples 20000
mem y8950.bin
# ADPCM-B's memory paths with the address shift from the memory type: the
# register-8 read path (two dummy reads that load the start, then bytes,
# EOS at the end, the wrap at the limit, nothing while executing or
# recording), the record path (external writes, EOS at the end and the
# write dropped), CPU feeding with BRDY, record with execute stopping the
# channel, and playback at every memory type with every pan.
# The image y8950.bin (written by tests/adpcm.rs): 1 KB segments of ADPCM-B
# at 0x000 (a sine), 0x400 (a ramp), 0x800 (noise) and 0xc00 (a square),
# then a 4 KB chirp at 0x1000. Register 0x00 is the control (0x80 start,
# 0x40 record, 0x20 external, 0x10 repeat, 0x01 reset), 0x01 pans (bits 7,
# 6) and the memory type (bit 1 8-bit DRAM, bit 0 ROM), 0x02-0x05 start and
# end, 0x08 the data, 0x09-0x0a delta-N, 0x0b the level, 0x0c-0x0d the
# limit. The flags byte is the status: 0x01 EOS, 0x02 BRDY, 0x04 playing.
