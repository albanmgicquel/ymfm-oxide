chip ym2151
clock 3579545
samples 30000
# The timers, status and IRQ line. Timer A counts 0x10 (high 8 bits) and
# 0x11 (low 2) against 1024, one sample a step; timer B counts 0x12 against
# 256 in steps of 16. 0x14 loads them (bits 0 and 1), lets them set their
# status flags (bits 2 and 3, the flags driving the IRQ line), and resets
# the flags (bits 4 and 5). Status reads land around each expiry, and
# straight after a write, which shows the busy bit. Offset 0 reads 0xFF.
# Then CSM (bit 7): every timer A expiry keys every operator of every
# channel on.
0 w 0 20 1 dc 0 38 1 00 0 40 1 01 0 60 1 18 0 80 1 1f 0 a0 1 00 0 c0 1 00 0 e0 1 0f 0 48 1 02 0 68 1 08 0 88 1 1f 0 a8 1 00 0 c8 1 00 0 e8 1 06 0 50 1 01 0 70 1 20 0 90 1 1f 0 b0 1 00 0 d0 1 00 0 f0 1 0f 0 58 1 01 0 78 1 0c 0 98 1 1f 0 b8 1 00 0 d8 1 00 0 f8 1 06 0 28 1 3a 0 30 1 00 0 08 1 78
0 w 0 10 1 fc 0 11 1 02  # timer A: 1024 - 0x3f2 = 14 samples
0 w 0 12 1 f0  # timer B: 16 x 16 samples
0 r 1
1 r 0
1 r 1
10 w 0 14 1 05  # load and enable timer A
10 r 1  # busy
11 r 1
23 r 1
24 r 1
25 r 1
100 w 0 14 1 15  # reset the flag, keep running
101 r 1
130 r 1
200 w 0 14 1 0f  # both loaded and enabled
201 r 1
470 r 1
480 r 1
500 w 0 14 1 3f  # reset both flags
501 r 1
600 w 0 14 1 03  # loaded but not enabled: no flags
1000 r 1
1200 w 0 14 1 0e  # timer A stops, B enabled
1600 r 1
2000 w 0 14 1 30  # both stop, flags reset
2001 r 1
# timer B reloads with a new value at its next expiry
3000 w 0 12 1 fe 0 14 1 0a
3010 w 0 12 1 80
3040 r 1
3050 w 0 14 1 2a
3051 r 1
5200 r 1
6000 w 0 14 1 30
# the longest timer A, 1024 samples, and timer A value 0x3ff, 1 sample
7000 w 0 10 1 00 0 11 1 00 0 14 1 05
8030 r 1
9000 w 0 14 1 30
9001 w 0 10 1 ff 0 11 1 03 0 14 1 05
9003 r 1
9010 w 0 14 1 30
9011 r 1
# CSM: the voice keyed off, then keyed on by timer A every 2000 samples
10000 w 0 08 1 00 0 21 1 c7 0 39 1 00 0 41 1 01 0 61 1 7f 0 81 1 1f 0 a1 1 00 0 c1 1 00 0 e1 1 0f 0 49 1 02 0 69 1 10 0 89 1 1f 0 a9 1 00 0 c9 1 00 0 e9 1 04 0 51 1 01 0 71 1 7f 0 91 1 1f 0 b1 1 00 0 d1 1 00 0 f1 1 0f 0 59 1 01 0 79 1 04 0 99 1 1f 0 b9 1 00 0 d9 1 00 0 f9 1 04 0 29 1 5a 0 31 1 00
11000 w 0 10 1 00 0 11 1 00 0 14 1 85  # CSM on, timer A 1024
11500 r 1
16000 w 0 10 1 82 0 11 1 01 0 14 1 95  # faster, flag reset
22000 w 0 14 1 05  # CSM off
24000 w 0 14 1 30
24001 r 1
