9800 w 0 0d 2 0e  # shape 14
10500 w 0 0d 2 ff  # shape 15
11200 w 0 0b 2 02 0 0d 2 0e  # triangle
11290 w 0 0d 2 0e  # rewritten mid-cycle
11340 w 0 0d 2 0a
11640 w 0 0b 2 00 0 0c 2 00 0 0d 2 0c  # period 0
