chip ym2149
clock 2000000
samples 2000
ssg-override
# An SSG override in place of the engine: it takes the resets (one as the
# override is installed, one before the first sample), every register
# write and every read of the data port, whatever the address's high bits;
# the engine, never written, stays silent, and no external I/O happens even
# with the ports set as outputs.
0 w 0 00 2 40 0 01 2 01 0 07 2 f8 0 08 2 0f
10 w 0 0e 2 5a 0 0f 2 c3
20 w 0 00
20 r 3
20 w 0 07
20 r 3
20 w 0 0e
20 r 3
30 w 3 2f 2 77  # address 0x2f: register 0x0f, high bits ignored
30 r 3
40 w 0 08 2 1f 0 0d 2 0e
40 r 3
40 r 0  # an inactive read
100 w 0 05 2 03
100 r 3
1000 w 0 0b 2 aa 0 0c 2 55
1000 w 0 0c
1000 r 3
