chip ym2610
clock 8000000
samples 8000
ssg-override
mem adpcm-a ym2610-a.bin
fidelity min
# An SSG override on the YM2610: reset as the chip is made, it takes the
# SSG writes and the reads below 0x0E; the SSG output stays 0 while FM and
# ADPCM-A play.
