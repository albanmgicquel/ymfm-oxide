chip ym3806
clock 3579545
samples 40000
# The timer, as ymfm guesses it: register 0x03 bit 0 loads and enables timer B
# and clears its status flag (bit 2), with a period of 16 x (256 - (0xC0 |
# bits 2-7)) samples. The flag raises the IRQ line. Writing 0x71, the value
# the PSR-70 uses, then acknowledging with the same write; reads of offset 0
# (status) and other offsets (0xFF); a new period applied on reload; stopping
# it with bit 0 clear. A note plays throughout.
0 w 10 c7 18 00 28 44 38 00 20 44 30 00 40 20 40 81 60 7f 80 1f a0 00 c0 00 e0 0f 48 20 48 81 68 7f 88 1f a8 00 c8 00 e8 0f 50 20 50 81 70 7f 90 1f b0 00 d0 00 f0 0f 58 20 58 81 78 10 98 1f b8 00 d8 00 f8 0f 5 40
0 r 0
0 r 1  # unknown offset
1 r 10
10 w 3 71  # period 16 x (256 - 0xDC) = 576
11 r 0
500 r 0
585 r 0
