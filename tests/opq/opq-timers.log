5001 r 0
6000 r 0
7000 w 3 01  # longest period, 1024
8100 r 0
9000 w 3 02  # bit 0 clear: stopped, flag kept
9001 r 0
10000 w 3 03
10000 w 3 03  # a second load while running is ignored
