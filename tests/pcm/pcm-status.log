chip ymf278b
clock 33868800
samples 30000
mem pcm wavetable.bin
# The status register. The first read after reset gives the chip ID for
# the mode (0x06 with neither NEW flag), later reads the status; setting
# NEW alone gives no ID, setting NEW2 makes the next read give 0x02.
# With NEW2, BUSY follows a write for 56 clocks (FM) or 88 (PCM), and LD
# follows a wave table load for 13 samples; without NEW2 both are masked.
# Timers A and B run at the OPL4's prescale of 19, with their flags, the
# masks and resets of register 4, and the IRQ line. A PCM voice plays
# throughout so the render is not silent.
0 r 0  # the ID: 0x06
0 r 0
1 w 2 05 3 01  # NEW only
1 r 0
2 w 2 05 3 03  # NEW2: the next read is the ID
2 r 0
2 r 0  # busy: the write was just now
3 r 0  # no longer busy
4 w 4 20 5 00 4 38 5 02 4 50 5 01 4 08 5 02 4 68 5 80  # loads wave 2: LD for 13 samples
4 r 0
5 r 0
16 r 0
17 r 0
18 r 0
20 w 4 50 5 01
20 r 0  # PCM busy
21 w 2 05 3 01  # NEW2 cleared: busy and LD masked
21 w 4 0a 5 02  # ignored without NEW2
21 r 0
22 w 2 05 3 03
22 w 4 0a 5 02  # a load on channel 2
22 r 0  # the ID again
22 r 0  # busy and LD
100 w 0 02 1 c0 0 03 1 80  # timer A and timer B values
100 r 0
100 w 0 04 1 03  # start both
200 r 0
400 r 0
800 r 0
1200 r 0
2000 r 0
3000 r 0
3100 w 0 04 1 80  # IRQ reset
3101 r 0
5000 r 0
5100 w 0 04 1 43  # mask A
5101 r 0
9000 r 0
9100 w 0 04 1 23  # mask B
9101 r 0
14000 r 0
14100 w 0 02 1 fe 0 04 1 01  # timer A alone, short
14101 r 0
14200 r 0
14300 w 0 04 1 80
14400 r 0
20000 w 0 04 1 00 0 04 1 80  # stop all
20001 r 0
25000 r 0
25000 r 1
25000 r 6
